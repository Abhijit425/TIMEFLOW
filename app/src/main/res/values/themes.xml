<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme only: Compose draws all UI, so no AppCompat dependency is needed. -->
    <style name="Theme.Timeflow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Timeflow.Fullscreen" parent="Theme.Timeflow">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
